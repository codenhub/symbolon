{
  // The repository's own code outside the workspace members: the root config files.
  "extends": "./tsconfig.node.json",
  // Node.js runs these files directly, with type stripping and no bundler, so they are checked by Node's rules:
  // NodeNext resolution, and relative imports written with the file's own extension, `.ts` or `.mjs`, as Node
  // requires.
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.root.tsbuildinfo"
  },
  "include": ["*.ts", "*.mjs"]
}
