{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "bracketSpacing": true,
  "htmlWhitespaceSensitivity": "ignore",
  "ignorePatterns": [
    "dist/**",
    "**/dist/**",
    "**/.wrangler/**",
    "coverage/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "pnpm-lock.yaml",
    "**/*.md"
  ],
  "printWidth": 120,
  "semi": true,
  "singleQuote": false,
  "sortImports": true,
  "sortPackageJson": true,
  "trailingComma": "all"
}
