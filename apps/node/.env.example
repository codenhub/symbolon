# Copy to apps/node/.env for `pnpm dev`. The .env file is git-ignored; never commit a real secret.
# docs/guides/operator.md describes every variable.

SYMBOLON_ISSUER=http://localhost:3000
# Generate one: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SYMBOLON_SECRET=
# Allows the http:// issuer above. Never set it on a reachable instance.
SYMBOLON_DEV_MODE=true
# A SQLite file (the default) or a postgres:// URL.
SYMBOLON_DATABASE=./data/symbolon.db
SYMBOLON_PORT=3000
